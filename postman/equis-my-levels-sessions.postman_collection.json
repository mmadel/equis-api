{
  "info": {
    "_postman_id": "4aba0673-9721-42af-82e6-3354791d3160",
    "name": "equis-my-levels-sessions",
    "description": "Riding Schedule \u2014 E3 trainer levels and sessions (M2\u2013M4) against equis-api: GET /me/levels, GET /me/levels/{id}/sessions, GET /me/sessions/{id} and PUT /me/sessions/{id}/assignments.\n\nBefore running:\n1. Dev database with V1\u2013V12 applied and sessions generated: trainer 1 is active and has at least two riders in level 1, and level 1 has an upcoming session with two seats free.\n2. trainerLogin / trainerPassword default to seeded trainer 1.\n\nRun order: 0 \u2192 4. Folder 2 picks the session, folder 3 remembers the trainer's seats in it, folder 4 changes them and puts them back.\nNot covered here (needs data the API cannot set up yet): session_closed (started or cancelled session), level_out_of_range, already_booked and capacity_exceeded on the PUT, and a cancelled session shown read-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 \u00b7 Sign in",
      "description": "Run first: every other request uses trainerAccessToken and the date range set here.",
      "item": [
        {
          "name": "Trainer login \u2192 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves trainerAccessToken (valid for 15 minutes), and from / to / toTooFar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{trainerLogin}}\",\n  \"password\": \"{{trainerPassword}}\",\n  \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"role = TRAINER\", () => pm.expect(b.role).to.eql(\"TRAINER\"));",
                  "pm.collectionVariables.set(\"trainerAccessToken\", b.accessToken);",
                  "// The range starts today and covers 56 days, the longest the API accepts.",
                  "const day = n => { const d = new Date(); d.setDate(d.getDate() + n); return d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\"); };",
                  "pm.collectionVariables.set(\"from\", day(0));",
                  "pm.collectionVariables.set(\"to\", day(55));",
                  "pm.collectionVariables.set(\"toTooFar\", day(56));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 \u00b7 My levels (M2)",
      "description": "GET /me/levels: the six levels with this week's numbers (Saturday to Friday, school time).",
      "item": [
        {
          "name": "All six levels \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/levels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "levels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Levels 1 to 6, in order\", () => pm.expect(list.map(l => l.id)).to.eql([1, 2, 3, 4, 5, 6]));",
                  "pm.test(\"Each has a name and a colour\", () => list.forEach(l => { pm.expect(l.name).to.be.a(\"string\"); pm.expect(l.colour).to.match(/^#[0-9A-Fa-f]{6}$/); }));",
                  "pm.test(\"Each has the four counts\", () => list.forEach(l => [\"sessionsThisWeek\", \"myRiders\", \"seatsFilled\", \"seatsTotal\"].forEach(k => pm.expect(l[k]).to.be.a(\"number\"))));",
                  "pm.test(\"Filled seats never exceed total seats\", () => list.forEach(l => pm.expect(l.seatsFilled).to.be.at.most(l.seatsTotal)));",
                  "pm.test(\"No sessions means no seats\", () => list.filter(l => l.sessionsThisWeek === 0).forEach(l => pm.expect(l.seatsTotal).to.eql(0)));",
                  "pm.test(\"Trainer has riders in the level under test\", () => pm.expect(list.find(l => l.id === Number(pm.collectionVariables.get(\"levelId\"))).myRiders).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token \u2192 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/levels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "levels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code = unauthorized\", () => pm.expect(pm.response.json().code).to.eql(\"unauthorized\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 Level sessions (M3)",
      "description": "GET /me/levels/{id}/sessions?from=&to=: scheduled sessions grouped by day. The range is at most 56 days, both ends included.",
      "item": [
        {
          "name": "Next 56 days \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/levels/{{levelId}}/sessions?from={{from}}&to={{to}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "levels",
                "{{levelId}}",
                "sessions"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{from}}"
                },
                {
                  "key": "to",
                  "value": "{{to}}"
                }
              ]
            },
            "description": "Saves sessionId and sessionDate for folders 3 and 4."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Echoes the level and the range\", () => { pm.expect(b.level.id).to.eql(Number(pm.collectionVariables.get(\"levelId\"))); pm.expect(b.from).to.eql(pm.collectionVariables.get(\"from\")); pm.expect(b.to).to.eql(pm.collectionVariables.get(\"to\")); });",
                  "pm.test(\"Days are in order, inside the range, never empty\", () => { const dates = b.days.map(d => d.date); pm.expect(dates).to.eql([...dates].sort()); b.days.forEach(d => { pm.expect(d.date >= b.from && d.date <= b.to).to.be.true; pm.expect(d.sessions).to.not.be.empty; }); });",
                  "const all = b.days.flatMap(d => d.sessions);",
                  "pm.test(\"Sessions of a day are in start order\", () => b.days.forEach(d => { const starts = d.sessions.map(s => s.start); pm.expect(starts).to.eql([...starts].sort()); }));",
                  "pm.test(\"booked = number of seats, at most capacity\", () => all.forEach(s => { pm.expect(s.booked).to.eql(s.seats.length); pm.expect(s.booked).to.be.at.most(s.capacity); pm.expect(s.past).to.be.a(\"boolean\"); }));",
                  "pm.test(\"Only my seats name a rider\", () => all.flatMap(s => s.seats).forEach(seat => { if (seat.mine) { pm.expect(seat.riderId).to.be.a(\"string\"); pm.expect(seat.initials).to.be.a(\"string\"); } else { pm.expect(seat).to.eql({ mine: false }); } }));",
                  "// Folders 3 and 4 use the first upcoming session where other trainers left at least two seats.",
                  "const pick = all.find(s => !s.past && s.capacity - s.seats.filter(seat => !seat.mine).length >= 2);",
                  "pm.test(\"Found an upcoming session with two seats free\", () => pm.expect(pick, \"run the session generator or seed level templates\").to.exist);",
                  "if (pick) { pm.collectionVariables.set(\"sessionId\", pick.id); pm.collectionVariables.set(\"sessionDate\", b.days.find(d => d.sessions.includes(pick)).date); }"
                ]
              }
            }
          ]
        },
