    {
      "name": "3 \u00b7 Session detail (M4)",
      "description": "GET /me/sessions/{id}: the session, my seats in it and my riders of its level. A missing or assessment session is a 404.",
      "item": [
        {
          "name": "The chosen session \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Saves originalRiderIds (to restore at the end) and twoRiderIds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Is the chosen session\", () => pm.expect(b.id).to.eql(pm.collectionVariables.get(\"sessionId\")));",
                  "pm.test(\"Level has id, name and colour\", () => { pm.expect(b.level.id).to.eql(Number(pm.collectionVariables.get(\"levelId\"))); pm.expect(b.level.name).to.be.a(\"string\"); pm.expect(b.level.colour).to.match(/^#[0-9A-Fa-f]{6}$/); });",
                  "pm.test(\"Date and HH:mm times\", () => { pm.expect(b.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(b.start).to.match(/^\\d{2}:\\d{2}$/); pm.expect(b.end).to.match(/^\\d{2}:\\d{2}$/); });",
                  "pm.test(\"Capacity, readOnly and otherCoachSeats\", () => { pm.expect(b.capacity).to.be.a(\"number\"); pm.expect(b.readOnly).to.be.a(\"boolean\"); pm.expect(b.otherCoachSeats).to.be.a(\"number\"); });",
                  "pm.test(\"inThisSession matches mySeats\", () => { const mine = b.mySeats.map(s => s.riderId).sort(); pm.expect(b.riders.filter(r => r.inThisSession).map(r => r.id).sort()).to.eql(mine); });",
                  "pm.test(\"Not read-only\", () => pm.expect(b.readOnly).to.be.false);",
                  "pm.test(\"At least two riders of mine in this level\", () => pm.expect(b.riders.length).to.be.at.least(2));",
                  "pm.test(\"Riders are in name order with initials\", () => { const names = b.riders.map(r => r.name); pm.expect(names).to.eql([...names].sort((x, y) => x.localeCompare(y))); b.riders.forEach(r => pm.expect(r.initials).to.be.a(\"string\")); });",
                  "// Folder 4 seats the first two riders, then puts this original list back.",
                  "pm.collectionVariables.set(\"originalRiderIds\", JSON.stringify(b.mySeats.map(s => s.riderId)));",
                  "pm.collectionVariables.set(\"twoRiderIds\", JSON.stringify(b.riders.slice(0, 2).map(r => r.id)));"
                ]
              }
            }
          ]
        },
