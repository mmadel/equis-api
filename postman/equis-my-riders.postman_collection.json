    {
      "name": "2 \u00b7 Rider level (4a)",
      "description": "GET /me/riders/{id}/level-history answers the whole Rider level page and its confirm sheet's impact.",
      "item": [
        {
          "name": "The chosen rider \u2192 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/riders/{{riderId}}/level-history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "riders",
                "{{riderId}}",
                "level-history"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Is the chosen rider\", () => { pm.expect(b.id).to.eql(pm.collectionVariables.get(\"riderId\")); pm.expect(b.name).to.eql(pm.collectionVariables.get(\"riderName\")); pm.expect(b.initials).to.be.a(\"string\"); });",
                  "pm.test(\"levelId and since\", () => { pm.expect(b.levelId).to.eql(Number(pm.collectionVariables.get(\"riderLevel\"))); pm.expect(b.since).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); });",
                  "pm.test(\"canPromote true, canDemote above Level 1\", () => { pm.expect(b.canPromote).to.eql(true); pm.expect(b.canDemote).to.eql(b.levelId > 1); });",
                  "pm.test(\"upcomingSeats have date and HH:mm times\", () => b.upcomingSeats.forEach(s => { pm.expect(s.sessionId).to.match(/^[0-9a-f-]{36}$/); pm.expect(s.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(s.start).to.match(/^\\d{2}:\\d{2}$/); pm.expect(s.end).to.match(/^\\d{2}:\\d{2}$/); }));",
                  "pm.test(\"history lines have type, levels, byName and at\", () => b.history.forEach(h => { pm.expect([\"placed\", \"promoted\", \"demoted\"]).to.include(h.type); pm.expect(h).to.have.property(\"fromLevelId\"); pm.expect(h.toLevelId).to.be.within(1, 6); pm.expect(h).to.have.property(\"reason\"); pm.expect(h.at).to.be.a(\"string\"); }));",
                  "// The seats the promotion should free, in date order.",
                  "pm.collectionVariables.set(\"upcomingSeatIds\", JSON.stringify(b.upcomingSeats.map(s => s.sessionId)));",
                  "pm.collectionVariables.set(\"oldSessionId\", b.upcomingSeats.length ? b.upcomingSeats[0].sessionId : \"\");",
                  "pm.collectionVariables.set(\"historyCount\", String(b.history.length));"
                ]
              }
            }
          ]
        },
