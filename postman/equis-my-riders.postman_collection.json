              ],
              "path": [
                "me",
                "levels"
              ]
            },
            "description": "Remembers myRiders on the rider's level and the one above, for the check after the promotion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const count = id => b.find(l => l.id === id).myRiders;",
                  "const from = Number(pm.collectionVariables.get(\"riderLevel\"));",
                  "pm.collectionVariables.set(\"myRidersFromBefore\", String(count(from)));",
                  "pm.collectionVariables.set(\"myRidersToBefore\", String(count(from + 1)));"
                ]
              }
            }
          ]
        },
