    {
      "name": "2 \u00b7 Create",
      "description": "POST returns 201 with a Location header, the saved template and any warnings. Upcoming sessions are generated 8 weeks ahead in the same transaction.",
      "item": [
        {
          "name": "Create level 3, Wednesday 10:00 \u2192 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/session-templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "session-templates"
              ]
            },
            "description": "Sets validFrom to today and saves templateId. Level 3 has no seeded templates, so no overlap.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"levelId\": 3,\n  \"dayOfWeek\": \"WEDNESDAY\",\n  \"start\": \"10:00\",\n  \"end\": \"11:00\",\n  \"capacity\": 6,\n  \"validFrom\": \"{{validFrom}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"validFrom\", new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Location points at the new template\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/admin/session-templates/\" + b.template.id));",
                  "pm.test(\"Template echoes the request\", () => { pm.expect(b.template.levelId).to.eql(3); pm.expect(b.template.dayOfWeek).to.eql(\"WEDNESDAY\"); pm.expect(b.template.start).to.eql(\"10:00\"); pm.expect(b.template.end).to.eql(\"11:00\"); pm.expect(b.template.capacity).to.eql(6); pm.expect(b.template.validFrom).to.eql(pm.collectionVariables.get(\"validFrom\")); });",
                  "pm.test(\"Nothing booked yet\", () => { pm.expect(b.template.maxBookedInUpcoming).to.eql(0); pm.expect(b.template.bookingsInUpcoming).to.eql(0); });",
                  "pm.test(\"No warnings\", () => pm.expect(b.warnings).to.eql([]));",
                  "pm.collectionVariables.set(\"templateId\", b.template.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an overlapping one \u2192 201 with warning",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
