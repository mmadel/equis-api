            },
            "description": "Same level and day, 10:30\u201311:30. An overlap is a warning, not an error: the template is saved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"levelId\": 3,\n  \"dayOfWeek\": \"WEDNESDAY\",\n  \"start\": \"10:30\",\n  \"end\": \"11:30\",\n  \"capacity\": 6,\n  \"validFrom\": \"{{validFrom}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"One overlap warning\", () => { pm.expect(b.warnings).to.have.lengthOf(1); pm.expect(b.warnings[0].code).to.eql(\"overlap\"); });",
                  "pm.test(\"Warning names the first template with HH:mm times\", () => pm.expect(b.warnings[0].overlaps).to.eql([{ id: pm.collectionVariables.get(\"templateId\"), start: \"10:00\", end: \"11:00\" }]));",
                  "pm.collectionVariables.set(\"overlapTemplateId\", b.template.id);"
                ]
              }
            }
          ]
        },
