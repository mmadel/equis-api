    {
      "name": "3 \u00b7 Edit",
      "description": "PUT sends the full template. Upcoming sessions take the new times and capacity; a day change cancels them and generates the new day.",
      "item": [
        {
          "name": "Change times and capacity \u2192 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/session-templates/{{templateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "session-templates",
                "{{templateId}}"
              ]
            },
            "body": {
              "mode": "raw",
