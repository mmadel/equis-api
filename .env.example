# Copy to .env (git-ignored) and fill in. Never commit real values.

# Public address of the trainer app, used in invite and set-password links
APP_BASE_URL=http://localhost:4200

# Public address of the rider app, used in rider invite and set-password links
APP_RIDER_BASE_URL=http://localhost:4202

# log prints emails to the console (no credentials needed); smtp sends them through Gmail
APP_MAIL_MODE=log
# Gmail address used to send; APP_MAIL_FROM must be the same address
APP_MAIL_FROM=
APP_MAIL_USERNAME=
# Gmail app password (16 characters, spaces removed), never the account password
APP_MAIL_PASSWORD=
